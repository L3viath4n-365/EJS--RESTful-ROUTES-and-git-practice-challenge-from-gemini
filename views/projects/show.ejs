<%- include('../partials/header.ejs') %>

    <main class="w-screen min-h-screen flex flex-col gap-3 justify-center items-center">
        <% if (locals.data) { %>

            <a href="/projects" class="capitalize font-bold text-slate-100 self-start ml-6 mb-10 hover:text-purple-800">🔙
            back to dashboard</a>
            
            <div
                class="flex flex-col w-[80%] h-[50vh] text-2xl gap-5 justify-between p-5 border border-white/10 backdrop-blur-xs max-w-full bg-linear-to-r from-zinc-800 via-zinc-400 to-yellow-400 rounded-2xl text-white font-bold overflow-hidden mx-auto">

                <h1 class="capitalize text-4xl text-slate-200">title: <%= data.title %>
                </h1>

                <div class="flex flex-col justify-between h-full">
                    <h2><span class="uppercase">s</span>tatus: <%= data.status %>
                    </h2>
                    <h2><span class="uppercase">d</span>ev title: <%= data.title %>
                    </h2>
                    <h2><span class="uppercase">t</span>ech stack: <%= data.tech_stack %>
                    </h2>
                </div>

                <div class="flex justify-between items-center mt-auto pt-2">
                    <p><span class="uppercase">h</span>ealth score: <%= data.health_score %>
                    </p>
                </div>


                <% } else {

                } %>
    </main>



    <%- include('../partials/footer.ejs') %>